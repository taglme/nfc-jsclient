{
    "name": "nfc-jsclient",
    "version": "2.0.2",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "repository": "https://github.com/taglme/nfc-jsclient.git",
    "author": "taglme <info@tagl.me>",
    "license": "MIT",
    "scripts": {
        "build": "tsc",
        "build-test": "tsc -p tsconfig.test.json",
        "build-example": "webpack --config example/webpack.config.js",
        "lint": "eslint ./src --ext ts",
        "prepare": "npm run build",
        "test": "npm run build-test && jest --passWithNoTests",
        "serve-example": "npx http-server ./dist/example",
        "example": "yarn && yarn build && yarn build-example && yarn serve-example "
    },
    "dependencies": {
        "axios": "^1.13.5",
        "buffer": "^5.4.3"
    },
    "devDependencies": {
        "axios-mock-adapter": "^2.1.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^20.11.30",
        "@typescript-eslint/eslint-plugin": "^8.56.0",
        "@typescript-eslint/parser": "^8.56.0",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.2.1",
        "html-webpack-plugin": "^5.6.6",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.2.0",
        "jest-websocket-mock": "^2.0.2",
        "mock-socket": "^9.3.1",
        "prettier": "^3.3.3",
        "ts-loader": "^9.5.2",
        "typescript": "^5.4.5",
        "webpack": "^5.105.2",
        "webpack-cli": "^5.1.4"
    },
    "files": [
        "dist"
    ]
}
